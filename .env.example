# ==============================================================================
# AI VOICE RECEPTIONIST — ENVIRONMENT CONFIGURATION
# ==============================================================================

# LiveKit WebRTC Cloud (Free tier at https://cloud.livekit.io)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Deepgram Nova-3 STT & Aura TTS (Free $200 credit at https://deepgram.com)
DEEPGRAM_API_KEY=your_deepgram_api_key

# Groq Cloud LLM (Ultra-fast LPU free tier at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
# Alternative speed demon: llama-3.1-8b-instant

# Supabase (Optional for logging & transcripts at https://supabase.com)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# RAG & Knowledge Settings
RAG_DATA_DIR=./data
SIMILARITY_THRESHOLD=0.48
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Server Port
PORT=8000
